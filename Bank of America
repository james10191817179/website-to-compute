<!DOCTYPE html>
<html>
<head>
  <title>MyBank Dashboard</title>
  <style>
    body { font-family: Arial; background: #f9f9f9; padding: 20px; }
    .header { background: #004080; color: white; padding: 20px; }
    .balance { font-size: 28px; margin: 20px 0; }
    .transactions { background: white; padding: 20px; border-radius: 5px; box-shadow: 0 0 10px #ddd; }
    .transaction { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #eee; }
    .logout { margin-top: 20px; }
    button { padding: 10px 20px; }
  </style>
</head>
<body>

<div class="header">
  <h1>Welcome, Shania Twain</h1>
</div>

<div class="balance">
  Current Balance: <strong>₦5,000,000.00</strong>
</div>

<div class="transactions">
  <h2>Recent Transactions</h2>
  <div class="transaction">
    <span>Aug 1, 2025 - POS Withdrawal</span>
    <span>-₦10,000</span>
  </div>
  <div class="transaction">
    <span>Jul 31, 2025 - Transfer from Mary</span>
    <span>+₦150,000</span>
  </div>
  <div class="transaction">
    <span>Jul 30, 2025 - Salary</span>
    <span>+₦600,000</span>
  </div>
</div>

<div class="logout">
  <button onclick="window.location.href='login.html'">Logout</button>
</div>

</body>
</html>
